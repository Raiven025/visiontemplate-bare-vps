APP_NAME=visiontemplate
APP_HOST=vision.example.com
REPO_URL=https://github.com/YOUR_GITHUB_USER/visiontemplate.git
BRANCH=main

APP_PORT=3000
CANDIDATE_PORT=3001
CONTAINER_PORT=3000
WEBHOOK_PORT=9000

POSTGRES_DB=vision_template
POSTGRES_USER=visiontemplate
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://visiontemplate:replace-with-a-long-random-password@visiontemplate-db:5432/vision_template

GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
BACKUP_RETENTION_DAYS=14
